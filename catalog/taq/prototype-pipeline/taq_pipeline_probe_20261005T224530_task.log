6          proc sql;
7            create table work.taq_libraries as
8            select distinct libname,engine,path
9            from dictionary.libnames
10           where libname in ('TAQ','TAQMSEC','TAQSAMP','TAQMSAMP')
11           order by libname,path;
NOTE: Table WORK.TAQ_LIBRARIES created, with 16 rows and 3 columns.

12         
13           create table work.taq_members as
14           select distinct libname,memname,memtype,memlabel,nvar,nobs,
15                  crdate format=datetime26.6,modate format=datetime26.6
16           from dictionary.tables
17           where libname='TAQMSEC'
18             and memname in ('CTM_20241007','CTM_20241008','CQM_20241007')
19             and memtype='DATA'
20           order by libname,memname;
NOTE: Table WORK.TAQ_MEMBERS created, with 3 rows and 8 columns.

21         
22           create table work.taq_columns as
23           select distinct
23       ! libname,memname,name,type,length,varnum,label,format,informat
24           from dictionary.columns
25           where libname='TAQMSEC'
26             and memname in ('CTM_20241007','CTM_20241008','CQM_20241007')
27             and memtype='DATA'
28           order by libname,memname,varnum;
NOTE: Table WORK.TAQ_COLUMNS created, with 59 rows and 9 columns.

29         quit;
NOTE: PROCEDURE SQL used (Total process time):
      real time           43.11 seconds
      cpu time            8.46 seconds
      

30         
31         /* Fixed-length hashes of every field avoid ambiguous delimiter
31       ! concatenation.
32            Ordered MD5 chains identify equal metadata layouts, not
32       ! observation content. */
33         data work.taq_layout_map;
34           set work.taq_columns;
35           by libname memname varnum;
36           length layout_id $32;
37           retain layout_id column_count;
38           if first.memname then do;
39             layout_id='';
40             column_count=0;
41           end;
42           column_count+1;
43           layout_id=put(md5(cats(
44             layout_id,
45             put(md5(strip(put(varnum,best32.))),hex32.),
46             put(md5(trim(name)),hex32.),
47             put(md5(trim(type)),hex32.),
48             put(md5(strip(put(length,best32.))),hex32.),
49             put(md5(trim(label)),hex32.),
50             put(md5(trim(format)),hex32.),
51             put(md5(trim(informat)),hex32.)
52           )),hex32.);
53           if last.memname then output;
54           keep libname memname layout_id column_count;
55         run;

NOTE: There were 59 observations read from the data set WORK.TAQ_COLUMNS.
NOTE: The data set WORK.TAQ_LAYOUT_MAP has 3 observations and 4 variables.
