339        
340        
341        /* Compare the production nested CATS expression against an explicit
341      ! buffer.
342           Synthetic metadata varies every field independently, including the
342      !  last
343           three fields that could otherwise be lost by a short temporary
343      ! buffer. */
344        data work.hash_buffer_probe;
345          length layout_id $32 name type $32 label $256 format informat $49;
346          length hash_input $256 hash_original hash_explicit $32;
347          do initial_row=0 to 1;
348            do test_case=1 to 8;
349              layout_id=repeat('A',31);
350              if initial_row then layout_id='';
351              varnum=2; name='TIME_M'; type='num'; length=8;
352              label='Test timestamp'; format='TIME20.9';
352      ! informat='B8601TM20.9';
353              if test_case=2 then label='Changed label';
354              if test_case=3 then format='TIME20.6';
355              if test_case=4 then informat='B8601TM20.6';
356              if test_case=5 then name='PART_TIME';
357              if test_case=6 then type='char';
358              if test_case=7 then length=4;
359              if test_case=8 then varnum=3;
360              hash_original=put(md5(cats(
361            layout_id,
362            put(md5(strip(put(varnum,best32.))),hex32.),
363            put(md5(trim(name)),hex32.),
364            put(md5(trim(type)),hex32.),
365            put(md5(strip(put(length,best32.))),hex32.),
366            put(md5(trim(label)),hex32.),
367            put(md5(trim(format)),hex32.),
368            put(md5(trim(informat)),hex32.)
369          )),hex32.);
370              hash_input=cats(
371            layout_id,
372            put(md5(strip(put(varnum,best32.))),hex32.),
373            put(md5(trim(name)),hex32.),
374            put(md5(trim(type)),hex32.),
375            put(md5(strip(put(length,best32.))),hex32.),
376            put(md5(trim(label)),hex32.),
377            put(md5(trim(format)),hex32.),
378            put(md5(trim(informat)),hex32.)
379          );
380              hash_explicit=put(md5(trim(hash_input)),hex32.);
381              buffer_length=lengthn(hash_input);
382              matches=(hash_original=hash_explicit);
383              output;
384            end;
385          end;
386          keep initial_row test_case buffer_length hash_original
386      ! hash_explicit matches;
387        run;

NOTE: The data set WORK.HASH_BUFFER_PROBE has 16 observations and 6 variables.
NOTE: DATA statement used (Total process time):
      real time           0.01 seconds
      cpu time            0.00 seconds
      

388        proc sql;
389          create table work.hash_buffer_validation as
390          select initial_row,count(*) as test_count,
391                 count(distinct hash_original) as distinct_original,
392                 count(distinct hash_explicit) as distinct_explicit,
393                 sum(matches=0) as mismatch_count
394          from work.hash_buffer_probe
395          group by initial_row;
NOTE: Table WORK.HASH_BUFFER_VALIDATION created, with 2 rows and 5 columns.

396        quit;
NOTE: PROCEDURE SQL used (Total process time):
