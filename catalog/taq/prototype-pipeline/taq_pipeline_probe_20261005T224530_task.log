67         proc sql;
68           create table work.taq_layout_columns as
69           select r.layout_id,c.*
70           from work.taq_columns as c
71           inner join work.layout_representatives as r
72             on c.libname=r.libname and c.memname=r.memname
73           order by r.layout_id,c.varnum;
NOTE: Table WORK.TAQ_LAYOUT_COLUMNS created, with 42 rows and 10 columns.

74         
75           create table work.taq_validation as
76           select t.libname,t.memname,t.nvar,m.column_count,m.layout_id,
77                  (t.nvar=m.column_count) as column_count_matches
78           from work.taq_members as t
79           left join work.taq_layout_map as m
80             on t.libname=m.libname and t.memname=m.memname
81           where missing(m.layout_id) or t.nvar ne m.column_count;
NOTE: Table WORK.TAQ_VALIDATION created, with 0 rows and 6 columns.

82         quit;
