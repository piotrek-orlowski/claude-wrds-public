64         
65         proc sql;
66           create table work.taq_layout_columns as
67           select r.layout_id,c.*
68           from work.taq_columns as c
69           inner join work.layout_representatives as r
70             on c.libname=r.libname and c.memname=r.memname
71           order by r.layout_id,c.varnum;
NOTE: Table WORK.TAQ_LAYOUT_COLUMNS created, with 2521 rows and 10 columns.

72         
73           create table work.taq_validation as
74           select t.libname,t.memname,t.nvar,m.column_count,m.layout_id,
75                  (t.nvar=m.column_count) as column_count_matches
76           from work.taq_members as t
77           left join work.taq_layout_map as m
78             on t.libname=m.libname and t.memname=m.memname
79           where missing(m.layout_id) or t.nvar ne m.column_count;
NOTE: Table WORK.TAQ_VALIDATION created, with 0 rows and 6 columns.

80         quit;
NOTE: PROCEDURE SQL used (Total process time):
      real time           0.21 seconds
      cpu time            0.23 seconds
      

