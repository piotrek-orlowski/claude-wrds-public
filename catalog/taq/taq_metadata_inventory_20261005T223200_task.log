

1          /* Metadata only. Never select observations from TAQ members. */
2          options notes source errorabend;
3          %let output_dir=%sysget(HOME)/scratch/wrds_taq_inventory;
4          %let run=taq_metadata_inventory_20261005T223200;
5          
6          proc sql;
7            create table work.taq_libraries as
8            select distinct libname,engine,path
9            from dictionary.libnames
10           where libname in ('TAQ','TAQMSEC','TAQSAMP','TAQMSAMP')
11           order by libname,path;
NOTE: Table WORK.TAQ_LIBRARIES created, with 16 rows and 3 columns.

12         
13           create table work.taq_members as
14           select distinct libname,memname,memtype,memlabel,nvar,nobs,
15                  crdate format=datetime26.6,modate format=datetime26.6
16           from dictionary.tables
17           where libname in ('TAQ','TAQMSEC','TAQSAMP','TAQMSAMP')
18             and memtype='DATA'
19           order by libname,memname;
NOTE: Table WORK.TAQ_MEMBERS created, with 82212 rows and 8 columns.

20         
21           create table work.taq_columns as
22           select distinct
22       ! libname,memname,name,type,length,varnum,label,format,informat
23           from dictionary.columns
24           where libname in ('TAQ','TAQMSEC','TAQSAMP','TAQMSAMP')
25             and memtype='DATA'
26           order by libname,memname,varnum;
NOTE: Table WORK.TAQ_COLUMNS created, with 1154370 rows and 9 columns.

27         quit;
NOTE: PROCEDURE SQL used (Total process time):
      real time           38:40.27
      cpu time            3:18.64
      

28         
29         /* Fixed-length hashes of every field avoid ambiguous delimiter
29       ! concatenation.
30            Ordered MD5 chains identify equal metadata layouts, not
30       ! observation content. */
31         data work.taq_layout_map;
32           set work.taq_columns;
33           by libname memname varnum;
34           length layout_id $32;
35           retain layout_id column_count;
36           if first.memname then do;
37             layout_id='';
38             column_count=0;
39           end;
40           column_count+1;
41           layout_id=put(md5(cats(
42             layout_id,
43             put(md5(strip(put(varnum,best32.))),hex32.),
44             put(md5(trim(name)),hex32.),
45             put(md5(trim(type)),hex32.),
46             put(md5(strip(put(length,best32.))),hex32.),
47             put(md5(trim(label)),hex32.),
48             put(md5(trim(format)),hex32.),
49             put(md5(trim(informat)),hex32.)
50           )),hex32.);
51           if last.memname then output;
52           keep libname memname layout_id column_count;
53         run;

NOTE: There were 1154370 observations read from the data set WORK.TAQ_COLUMNS.
NOTE: The data set WORK.TAQ_LAYOUT_MAP has 82212 observations and 4 variables.
NOTE: DATA statement used (Total process time):
      real time           3.78 seconds
      cpu time            3.76 seconds
      

54         
55         proc sort data=work.taq_layout_map out=work.sorted_layout_map;
56           by layout_id libname memname;
57         run;

